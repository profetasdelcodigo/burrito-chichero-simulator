{
  "name": "burritochichero",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "pnpm --dir server start",
    "build": "node scripts/manus-game-sharing/build.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:server": "pnpm --dir server test",
    "smoke": "node scripts/smoke.mjs",
    "android:sync": "pnpm build && cap sync android",
    "android:debug": "pnpm android:sync && gradle -p android :app:assembleDebug",
    "manus:build-source": "tsc --noEmit && vite build && node scripts/check-size.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@supabase/supabase-js": "^2.118.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.18.0"
}
